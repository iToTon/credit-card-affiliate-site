---
// カテゴリーごとのラインアイコン。24x24のviewBoxに統一し、線の太さ・端の処理も揃えている。
// 色は currentColor を継承するため、呼び出し側で text-* や style="color:..." を指定する。
interface Props {
  slug: string;
  size?: number;
  class?: string;
}

const { slug, size = 24, class: className = "" } = Astro.props;

const common = {
  width: size,
  height: size,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": 1.75,
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
  "aria-hidden": "true",
  class: className,
};
---

{/* 選び方・比較: 高さの違う2本のバー(比較) */}
{
  slug === "how-to-choose" && (
    <svg {...common}>
      <rect x="3.5" y="10" width="6" height="10.5" rx="1.5" />
      <rect x="14.5" y="3.5" width="6" height="17" rx="1.5" />
    </svg>
  )
}

{/* 審査・発行: 書類とチェック */}
{
  slug === "screening" && (
    <svg {...common}>
      <path d="M13 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V9z" />
      <path d="M13 3v4.5A1.5 1.5 0 0 0 14.5 9H19" />
      <path d="M8.75 15.25 10.5 17l4-4.25" />
    </svg>
  )
}

{/* 使い方の基礎知識: 開いた本 */}
{
  slug === "how-it-works" && (
    <svg {...common}>
      <path d="M12 6.5C10.5 5 8.5 4.5 4 4.5v13c4.5 0 6.5.5 8 2 1.5-1.5 3.5-2 8-2v-13c-4.5 0-6.5.5-8 2z" />
      <path d="M12 6.5v13" />
    </svg>
  )
}

{/* ポイント・特典活用: 星 */}
{
  slug === "points" && (
    <svg {...common}>
      <path d="m12 3.5 2.6 5.3 5.9.85-4.25 4.15 1 5.85L12 16.9l-5.25 2.75 1-5.85L3.5 9.65l5.9-.85z" />
    </svg>
  )
}

{/* 法人・個人事業主向け: ブリーフケース */}
{
  slug === "business" && (
    <svg {...common}>
      <rect x="3" y="7.5" width="18" height="12.5" rx="2" />
      <path d="M9 7.5V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5" />
      <path d="M3 12.5h18" />
    </svg>
  )
}

{/* 支払い活用術: 明細・レシート */}
{
  slug === "everyday-payments" && (
    <svg {...common}>
      <path d="M5 3.5h14v17l-2.33-1.6-2.34 1.6L12 18.9l-2.33 1.6-2.34-1.6L5 20.5z" />
      <path d="M9 8.5h6" />
      <path d="M9 12.5h6" />
    </svg>
  )
}

{/* トラブル対応・セキュリティ: 盾 */}
{
  slug === "trouble" && (
    <svg {...common}>
      <path d="M12 3.25 4.75 6.1v5.4c0 4.35 3 7.9 7.25 9.25 4.25-1.35 7.25-4.9 7.25-9.25V6.1z" />
      <path d="M12 9v3.5" />
      <circle cx="12" cy="15.75" r="0.9" fill="currentColor" stroke="none" />
    </svg>
  )
}

{/* 個別カードレビュー: クレジットカード */}
{
  slug === "card-reviews" && (
    <svg {...common}>
      <rect x="2.75" y="5" width="18.5" height="14" rx="2.25" />
      <path d="M2.75 9.75h18.5" />
      <path d="M6.5 14.75h3.5" />
    </svg>
  )
}

{/* 属性別ガイド: 人物 */}
{
  slug === "life-stage" && (
    <svg {...common}>
      <circle cx="9.25" cy="8" r="3.25" />
      <path d="M3.5 20.25c0-3.2 2.57-5.5 5.75-5.5s5.75 2.3 5.75 5.5" />
      <path d="M16.5 5.15a3.25 3.25 0 0 1 0 5.7" />
      <path d="M18.25 14.95c1.4.86 2.25 2.28 2.25 4" />
    </svg>
  )
}
