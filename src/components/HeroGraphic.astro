---
// トップページのヒーロー用の装飾イラスト。重なったカードを抽象化したもの。
// 画像ファイルではなくSVGなので、拡大しても劣化せず読み込みコストもほぼゼロ。
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  viewBox="0 0 320 240"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="重なったクレジットカードのイラスト"
  class={`h-auto w-full ${className}`}
>
  <defs>
    <linearGradient id="hero-card-front" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="oklch(56% 0.17 253)"></stop>
      <stop offset="100%" stop-color="oklch(42% 0.17 262)"></stop>
    </linearGradient>
    <linearGradient id="hero-card-mid" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="oklch(78% 0.09 250)"></stop>
      <stop offset="100%" stop-color="oklch(66% 0.11 255)"></stop>
    </linearGradient>
  </defs>

  <!-- 背景の光 -->
  <circle cx="196" cy="96" r="78" fill="oklch(58% 0.15 253)" opacity="0.08"></circle>

  <!-- 奥のカード -->
  <rect
    x="60"
    y="40"
    width="176"
    height="108"
    rx="14"
    fill="oklch(92% 0.03 250)"
    transform="rotate(-13 148 94)"></rect>

  <!-- 中央のカード -->
  <rect x="72" y="58" width="176" height="108" rx="14" fill="url(#hero-card-mid)" transform="rotate(-6 160 112)"
  ></rect>

  <!-- 手前のカード -->
  <g transform="rotate(3 172 132)">
    <rect x="84" y="78" width="176" height="108" rx="14" fill="url(#hero-card-front)"></rect>
    <!-- ICチップ -->
    <rect x="102" y="104" width="26" height="19" rx="4" fill="oklch(84% 0.11 88)" opacity="0.95"></rect>
    <path d="M102 113.5h26M115 104v19" stroke="oklch(58% 0.1 88)" stroke-width="1.2" opacity="0.7"></path>
    <!-- タッチ決済マーク -->
    <g stroke="white" stroke-width="2.1" stroke-linecap="round" opacity="0.85">
      <path d="M142 106.5a9.5 9.5 0 0 1 0 14"></path>
      <path d="M149 101.5a16.5 16.5 0 0 1 0 24"></path>
    </g>
    <!-- 番号を模したバー -->
    <g fill="white" opacity="0.5">
      <rect x="102" y="140" width="34" height="6" rx="3"></rect>
      <rect x="142" y="140" width="34" height="6" rx="3"></rect>
      <rect x="182" y="140" width="34" height="6" rx="3"></rect>
    </g>
    <rect x="102" y="158" width="52" height="5" rx="2.5" fill="white" opacity="0.32"></rect>
  </g>

  <!-- 装飾のドット -->
  <circle cx="272" cy="60" r="7" fill="oklch(72% 0.13 75)" opacity="0.75"></circle>
  <circle cx="52" cy="176" r="5" fill="oklch(60% 0.14 253)" opacity="0.5"></circle>
  <circle cx="292" cy="168" r="4" fill="oklch(60% 0.14 155)" opacity="0.5"></circle>
</svg>
