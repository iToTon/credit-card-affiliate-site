---
import { siteConfig, categories } from "../site.config";
---

<header class="border-b-[3px] border-gold-600 bg-navy-900">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-6 px-4 py-5">
    <a href="/" class="font-heading text-xl font-bold text-white">
      {siteConfig.name}
    </a>
    <nav class="flex gap-7 text-sm">
      <a href="/articles/" class="font-medium text-navy-50/85 hover:text-white">記事一覧</a>
      {
        categories.map((c) => (
          <a href={`/category/${c.slug}/`} class="font-medium text-navy-50/85 hover:text-white">
            {c.name}
          </a>
        ))
      }
      <a href="/about/" class="font-medium text-navy-50/85 hover:text-white">運営者情報</a>
    </nav>
  </div>
</header>
