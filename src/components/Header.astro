---
import { siteConfig, categories } from "../site.config";
---

<header class="border-b border-slate-200 bg-canvas">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-6 px-4 py-5">
    <a href="/" class="text-xl font-extrabold tracking-tight text-ink">
      {siteConfig.name}
    </a>
    <nav class="flex gap-7 text-sm">
      <a href="/articles/" class="font-bold text-ink hover:text-blue-600">記事一覧</a>
      {
        categories.map((c) => (
          <a href={`/category/${c.slug}/`} class="font-bold text-ink hover:text-blue-600">
            {c.name}
          </a>
        ))
      }
      <a href="/about/" class="font-bold text-ink hover:text-blue-600">運営者情報</a>
    </nav>
  </div>
</header>
