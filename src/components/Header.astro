---
import { siteConfig, categories } from "../site.config";
---

<header class="border-b border-slate-200">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="text-lg font-bold text-slate-900">
      {siteConfig.name}
    </a>
    <nav class="flex gap-4 text-sm">
      <a href="/articles/" class="text-slate-600 hover:text-slate-900">記事一覧</a>
      {
        categories.map((c) => (
          <a href={`/category/${c.slug}/`} class="text-slate-600 hover:text-slate-900">
            {c.name}
          </a>
        ))
      }
      <a href="/about/" class="text-slate-600 hover:text-slate-900">運営者情報</a>
    </nav>
  </div>
</header>
