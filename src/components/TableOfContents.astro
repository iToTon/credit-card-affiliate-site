---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 2 && (
    <nav aria-label="目次" class="mb-9 rounded-2xl border border-slate-200 bg-band px-6 py-5">
      <p class="mb-3 text-sm font-extrabold text-ink">目次</p>
      <ol class="flex flex-col gap-2 text-[14px] leading-relaxed">
        {items.map((h) => (
          <li class={h.depth === 3 ? "pl-4" : ""}>
            <a href={`#${h.slug}`} class="text-blue-700 hover:underline">
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
