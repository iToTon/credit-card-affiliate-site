---
import { getCollection } from "astro:content";
import ArticleThumb from "./ArticleThumb.astro";

interface Props {
  currentId: string;
  category: string;
  limit?: number;
}

const { currentId, category, limit = 4 } = Astro.props;

const all = await getCollection("articles", ({ data }) => !data.draft);

const sameCategory = all
  .filter((a) => a.id !== currentId && a.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

let related = sameCategory.slice(0, limit);

if (related.length < limit) {
  const pickedIds = new Set([currentId, ...related.map((a) => a.id)]);
  const fallback = all
    .filter((a) => !pickedIds.has(a.id))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, limit - related.length);
  related = [...related, ...fallback];
}
---

{
  related.length > 0 && (
    <aside class="mt-12 border-t border-slate-200 pt-10">
      <h2 class="mb-5 text-lg font-extrabold text-ink">あわせて読みたい</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {related.map((article) => (
          <a
            href={`/articles/${article.id}/`}
            class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 hover:border-blue-600"
          >
            <ArticleThumb slug={article.id} category={article.data.category} class="aspect-[16/9]" iconSize={34} />
            <span class="flex flex-1 flex-col gap-2 p-5">
              <span class="text-[15px] font-bold leading-snug text-ink group-hover:text-blue-700">
                {article.data.title}
              </span>
              <span class="text-[13px] leading-relaxed text-ink-muted">{article.data.description}</span>
            </span>
          </a>
        ))}
      </div>
    </aside>
  )
}
