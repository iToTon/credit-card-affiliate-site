---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { categories } from "../../site.config";
import { breadcrumbListSchema } from "../../schema";

export async function getStaticPaths() {
  return categories.map((c) => ({
    params: { slug: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const allArticles = await getCollection(
  "articles",
  ({ data }) => !data.draft && data.category === category.slug,
);
const sorted = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbItems = [
  { label: "ホーム", href: "/" },
  { label: category.name, href: `/category/${category.slug}/` },
];
---

<BaseLayout
  title={category.name}
  description={category.description}
  jsonLd={[breadcrumbListSchema(breadcrumbItems)]}
>
  <Breadcrumbs items={breadcrumbItems} />
  <h1 class="mb-2 text-2xl font-extrabold tracking-tight text-ink">{category.name}</h1>
  <p class="mb-8 leading-relaxed text-ink-muted">{category.description}</p>

  {sorted.length === 0 && <p class="text-ink-muted">このカテゴリーの記事はまだありません。</p>}
  <div class="grid gap-4">
    {
      sorted.map((article) => (
        <a
          href={`/articles/${article.id}/`}
          class="group flex flex-col gap-2.5 rounded-2xl border border-slate-200 p-6 hover:border-blue-600"
        >
          <span class="text-lg font-extrabold leading-snug text-ink group-hover:text-blue-700">
            {article.data.title}
          </span>
          <span class="text-[13.5px] leading-relaxed text-ink-muted">{article.data.description}</span>
        </a>
      ))
    }
  </div>
</BaseLayout>
