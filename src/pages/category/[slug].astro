---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categories } from "../../site.config";

export async function getStaticPaths() {
  return categories.map((c) => ({
    params: { slug: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const allArticles = await getCollection(
  "articles",
  ({ data }) => !data.draft && data.category === category.slug,
);
const sorted = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={category.name} description={category.description}>
  <h1 class="mb-2 text-2xl font-extrabold tracking-tight text-ink">{category.name}</h1>
  <p class="mb-8 text-slate-600">{category.description}</p>

  {sorted.length === 0 && <p class="text-slate-500">このカテゴリーの記事はまだありません。</p>}
  <div class="divide-y divide-slate-200">
    {
      sorted.map((article) => (
        <div class="flex flex-col gap-2.5 py-6 first:pt-0">
          <a
            href={`/articles/${article.id}/`}
            class="text-lg font-extrabold text-ink hover:underline"
          >
            {article.data.title}
          </a>
          <p class="text-[13.5px] leading-relaxed text-slate-500">{article.data.description}</p>
        </div>
      ))
    }
  </div>
</BaseLayout>
