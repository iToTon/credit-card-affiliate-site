---
import { getCollection } from "astro:content";
import ArticleThumb from "../../components/ArticleThumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import { categories } from "../../site.config";
import { breadcrumbListSchema } from "../../schema";

export async function getStaticPaths() {
  return categories.map((c) => ({
    params: { slug: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const allArticles = await getCollection(
  "articles",
  ({ data }) => !data.draft && data.category === category.slug,
);
const sorted = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbItems = [
  { label: "ホーム", href: "/" },
  { label: category.name, href: `/category/${category.slug}/` },
];
---

<BaseLayout
  title={category.name}
  description={category.description}
  jsonLd={[breadcrumbListSchema(breadcrumbItems)]}
>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="mb-8 flex items-start gap-4">
    <span
      class="flex size-14 shrink-0 items-center justify-center rounded-2xl"
      style={`background: ${category.tint}; color: ${category.accent};`}
    >
      <CategoryIcon slug={category.slug} size={28} />
    </span>
    <div>
      <h1 class="mb-1.5 text-2xl font-extrabold tracking-tight text-ink">{category.name}</h1>
      <p class="leading-relaxed text-ink-muted">{category.description}</p>
    </div>
  </div>

  {sorted.length === 0 && <p class="text-ink-muted">このカテゴリーの記事はまだありません。</p>}
  <div class="grid gap-4">
    {
      sorted.map((article) => (
        <a
          href={`/articles/${article.id}/`}
          class="group grid gap-4 overflow-hidden rounded-2xl border border-slate-200 hover:border-blue-600 sm:grid-cols-[168px_1fr] sm:gap-0"
        >
          <ArticleThumb
            slug={article.id}
            category={article.data.category}
            class="h-28 sm:h-full"
            iconSize={34}
          />
          <span class="flex flex-col gap-2.5 px-6 pb-6 sm:py-6">
            <span class="text-lg font-extrabold leading-snug text-ink group-hover:text-blue-700">
              {article.data.title}
            </span>
            <span class="text-[13.5px] leading-relaxed text-ink-muted">{article.data.description}</span>
          </span>
        </a>
      ))
    }
  </div>
</BaseLayout>
