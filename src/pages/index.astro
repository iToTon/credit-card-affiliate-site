---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig, categories } from "../site.config";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const latest = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 10);
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="mb-14">
    <h1 class="mb-4 font-heading text-3xl font-bold text-navy-900">{siteConfig.name}</h1>
    <p class="max-w-xl leading-relaxed text-slate-600">{siteConfig.description}</p>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 font-heading text-lg font-bold text-navy-900">カテゴリー</h2>
    <div class="flex flex-wrap gap-2">
      {
        categories.map((c) => (
          <a
            href={`/category/${c.slug}/`}
            class="rounded-full border-[1.5px] border-navy-700 px-5 py-2 text-sm font-semibold text-navy-700 hover:bg-navy-700 hover:text-white"
          >
            {c.name}
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="mb-6 font-heading text-lg font-bold text-navy-900">新着記事</h2>
    {latest.length === 0 && <p class="text-slate-500">まだ記事がありません。</p>}
    <div class="grid gap-5 sm:grid-cols-2">
      {
        latest.map((article) => {
          const categoryInfo = categories.find((c) => c.slug === article.data.category);
          return (
            <a
              href={`/articles/${article.id}/`}
              class="group flex flex-col gap-2.5 rounded-[10px] border border-slate-200 bg-white p-5 shadow-[0_1px_2px_rgba(20,20,30,0.06),0_4px_12px_rgba(20,20,30,0.06)]"
            >
              {categoryInfo && (
                <span class="w-fit rounded-md bg-navy-700 px-2.5 py-1 text-xs font-semibold text-white">
                  {categoryInfo.name}
                </span>
              )}
              <span class="font-heading text-[17px] font-semibold leading-snug text-slate-900 group-hover:text-navy-700 group-hover:underline">
                {article.data.title}
              </span>
              <span class="text-[13px] leading-relaxed text-slate-500">{article.data.description}</span>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
