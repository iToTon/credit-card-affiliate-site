---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig, categories } from "../site.config";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const latest = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 10);
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <section class="mb-10">
    <h1 class="mb-3 text-2xl font-bold text-slate-900">{siteConfig.name}</h1>
    <p class="text-slate-600">{siteConfig.description}</p>
  </section>

  <section class="mb-10">
    <h2 class="mb-4 text-lg font-semibold text-slate-900">カテゴリー</h2>
    <div class="flex flex-wrap gap-2">
      {
        categories.map((c) => (
          <a
            href={`/category/${c.slug}/`}
            class="rounded-full border border-slate-300 px-4 py-1.5 text-sm text-slate-700 hover:border-blue-400 hover:text-blue-700"
          >
            {c.name}
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="mb-4 text-lg font-semibold text-slate-900">新着記事</h2>
    {latest.length === 0 && <p class="text-slate-500">まだ記事がありません。</p>}
    <ul class="space-y-4">
      {
        latest.map((article) => (
          <li class="border-b border-slate-100 pb-4">
            <a href={`/articles/${article.id}/`} class="text-lg font-semibold text-slate-900 hover:text-blue-700">
              {article.data.title}
            </a>
            <p class="mt-1 text-sm text-slate-500">{article.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
