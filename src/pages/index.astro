---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig, categories } from "../site.config";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const latest = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 10);
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <div class="mb-14 rounded-lg bg-band px-8 py-14 sm:px-12">
    <h1 class="mb-4 max-w-xl text-4xl font-extrabold tracking-tight text-ink">{siteConfig.name}</h1>
    <p class="mb-8 max-w-lg leading-relaxed text-ink-muted">{siteConfig.description}</p>
    <a
      href="/articles/"
      class="inline-block rounded-full bg-blue-600 px-8 py-3.5 text-sm font-bold text-white hover:bg-blue-700"
    >
      記事を読んでみる
    </a>
  </div>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-extrabold text-ink">カテゴリー</h2>
    <div class="flex flex-wrap gap-2">
      {
        categories.map((c) => (
          <a
            href={`/category/${c.slug}/`}
            class="rounded-full bg-blue-50 px-5 py-2 text-sm font-bold text-blue-700 hover:bg-blue-600 hover:text-white"
          >
            {c.name}
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="mb-6 text-xl font-extrabold text-ink">新着記事</h2>
    {latest.length === 0 && <p class="text-slate-500">まだ記事がありません。</p>}
    <div class="grid gap-5 sm:grid-cols-2">
      {
        latest.map((article) => {
          const categoryInfo = categories.find((c) => c.slug === article.data.category);
          return (
            <a
              href={`/articles/${article.id}/`}
              class="group flex flex-col gap-3 rounded border border-slate-200 p-6"
            >
              {categoryInfo && (
                <span class="w-fit rounded bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700">
                  {categoryInfo.name}
                </span>
              )}
              <span class="text-lg font-extrabold leading-snug text-ink group-hover:underline">
                {article.data.title}
              </span>
              <span class="text-[13px] leading-relaxed text-ink-muted">{article.data.description}</span>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
