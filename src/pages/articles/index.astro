---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categories } from "../../site.config";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const sorted = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="記事一覧" description="これまでに公開した記事の一覧です。">
  <h1 class="mb-2 text-2xl font-extrabold tracking-tight text-ink">記事一覧</h1>
  <p class="mb-8 text-ink-muted">これまでに公開した{sorted.length}本の記事を、新しい順に並べています。</p>
  {sorted.length === 0 && <p class="text-ink-muted">まだ記事がありません。</p>}
  <div class="grid gap-4">
    {
      sorted.map((article) => {
        const categoryInfo = categories.find((c) => c.slug === article.data.category);
        return (
          <a
            href={`/articles/${article.id}/`}
            class="group flex flex-col gap-2.5 rounded-2xl border border-slate-200 p-6 hover:border-blue-600"
          >
            {categoryInfo && (
              <span class="w-fit rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">
                {categoryInfo.name}
              </span>
            )}
            <span class="text-lg font-extrabold leading-snug text-ink group-hover:text-blue-700">
              {article.data.title}
            </span>
            <span class="text-[13.5px] leading-relaxed text-ink-muted">{article.data.description}</span>
          </a>
        );
      })
    }
  </div>
</BaseLayout>
