---
import { getCollection } from "astro:content";
import ArticleThumb from "../../components/ArticleThumb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categories } from "../../site.config";

const allArticles = await getCollection("articles", ({ data }) => !data.draft);
const sorted = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="記事一覧" description="これまでに公開した記事の一覧です。">
  <h1 class="mb-2 text-2xl font-extrabold tracking-tight text-ink">記事一覧</h1>
  <p class="mb-8 text-ink-muted">これまでに公開した{sorted.length}本の記事を、新しい順に並べています。</p>
  {sorted.length === 0 && <p class="text-ink-muted">まだ記事がありません。</p>}
  <div class="grid gap-4">
    {
      sorted.map((article) => {
        const categoryInfo = categories.find((c) => c.slug === article.data.category);
        return (
          <a
            href={`/articles/${article.id}/`}
            class="group grid gap-4 overflow-hidden rounded-2xl border border-slate-200 hover:border-blue-600 sm:grid-cols-[168px_1fr] sm:gap-0"
          >
            <ArticleThumb
              slug={article.id}
              category={article.data.category}
              class="h-28 sm:h-full"
              iconSize={34}
            />
            <span class="flex flex-col gap-2.5 px-6 pb-6 sm:py-6">
              {categoryInfo && (
                <span
                  class="w-fit rounded-full px-3 py-1 text-xs font-bold"
                  style={`background: ${categoryInfo.tint}; color: ${categoryInfo.accent};`}
                >
                  {categoryInfo.name}
                </span>
              )}
              <span class="text-lg font-extrabold leading-snug text-ink group-hover:text-blue-700">
                {article.data.title}
              </span>
              <span class="text-[13.5px] leading-relaxed text-ink-muted">{article.data.description}</span>
            </span>
          </a>
        );
      })
    }
  </div>
</BaseLayout>
