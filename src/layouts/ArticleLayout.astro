---
import BaseLayout from "./BaseLayout.astro";
import AdDisclosure from "../components/AdDisclosure.astro";
import { categories } from "../site.config";

interface Props {
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  updatedDate?: Date;
  ogImage?: string;
}

const { title, description, category, pubDate, updatedDate, ogImage } = Astro.props;
const categoryInfo = categories.find((c) => c.slug === category);

const dateFormat: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <article>
    {categoryInfo && (
      <a
        href={`/category/${categoryInfo.slug}/`}
        class="mb-3 inline-block text-xs font-bold text-navy-700 hover:underline"
      >
        {categoryInfo.name}
      </a>
    )}
    <h1 class="mb-3 font-heading text-3xl font-bold leading-snug text-navy-900">{title}</h1>
    <div class="mb-7 text-sm text-slate-500">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString("ja-JP", dateFormat)} 公開
      </time>
      {updatedDate && (
        <span>
          ({updatedDate.toLocaleDateString("ja-JP", dateFormat)} 更新)
        </span>
      )}
    </div>

    <AdDisclosure />

    <div class="prose prose-slate max-w-none prose-headings:font-heading prose-headings:text-navy-900 prose-a:text-navy-700 prose-a:no-underline hover:prose-a:underline prose-strong:text-navy-900">
      <slot />
    </div>
  </article>
</BaseLayout>
