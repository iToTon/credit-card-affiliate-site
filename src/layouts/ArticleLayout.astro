---
import BaseLayout from "./BaseLayout.astro";
import AdDisclosure from "../components/AdDisclosure.astro";
import ArticleThumb from "../components/ArticleThumb.astro";
import AuthorBox from "../components/AuthorBox.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { categories } from "../site.config";
import { articleSchema, breadcrumbListSchema } from "../schema";

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  updatedDate?: Date;
  ogImage?: string;
  headings: { depth: number; slug: string; text: string }[];
  // 記事本文にアフィリエイト要素が含まれるか。広告表記バナーの出し分けに使う
  hasAds?: boolean;
}

const {
  slug,
  title,
  description,
  category,
  pubDate,
  updatedDate,
  ogImage,
  headings,
  hasAds = false,
} = Astro.props;
const categoryInfo = categories.find((c) => c.slug === category);

const dateFormat: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };

const articleHref = `/articles/${slug}/`;
// フロントマターでの指定が無ければ、ビルド時に生成した記事別のOGP画像を使う
const ogImageUrl = ogImage ?? `/og/${slug}.png`;
const breadcrumbItems = [
  { label: "ホーム", href: "/" },
  ...(categoryInfo ? [{ label: categoryInfo.name, href: `/category/${categoryInfo.slug}/` }] : []),
  { label: title, href: articleHref },
];

const jsonLd = [
  articleSchema({ title, description, href: articleHref, pubDate, updatedDate, image: ogImageUrl }),
  breadcrumbListSchema(breadcrumbItems),
];
---

<BaseLayout title={title} description={description} ogImage={ogImageUrl} jsonLd={jsonLd}>
  <article>
    <Breadcrumbs items={breadcrumbItems} />

    <ArticleThumb slug={slug} category={category} class="mb-6 aspect-[3/1] rounded-2xl" iconSize={54} />

    {categoryInfo && (
      <a
        href={`/category/${categoryInfo.slug}/`}
        class="mb-4 inline-block rounded-full px-3 py-1 text-xs font-bold hover:underline"
        style={`background: ${categoryInfo.tint}; color: ${categoryInfo.accent};`}
      >
        {categoryInfo.name}
      </a>
    )}
    <h1 class="mb-3 text-3xl font-extrabold leading-snug tracking-tight text-ink">{title}</h1>
    <div class="mb-7 text-sm text-ink-muted">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString("ja-JP", dateFormat)} 公開
      </time>
      {updatedDate && (
        <span>
          ({updatedDate.toLocaleDateString("ja-JP", dateFormat)} 更新)
        </span>
      )}
    </div>

    {hasAds && <AdDisclosure />}

    <TableOfContents headings={headings} />

    <div class="prose prose-slate max-w-none prose-headings:font-extrabold prose-headings:text-ink prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline prose-strong:text-ink">
      <slot />
    </div>
  </article>

  <AuthorBox />

  <RelatedArticles currentId={slug} category={category} />
</BaseLayout>
