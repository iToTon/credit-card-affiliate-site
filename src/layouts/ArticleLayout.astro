---
import BaseLayout from "./BaseLayout.astro";
import AdDisclosure from "../components/AdDisclosure.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import { categories } from "../site.config";
import { articleSchema, breadcrumbListSchema } from "../schema";

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  updatedDate?: Date;
  ogImage?: string;
}

const { slug, title, description, category, pubDate, updatedDate, ogImage } = Astro.props;
const categoryInfo = categories.find((c) => c.slug === category);

const dateFormat: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };

const articleHref = `/articles/${slug}/`;
const breadcrumbItems = [
  { label: "ホーム", href: "/" },
  ...(categoryInfo ? [{ label: categoryInfo.name, href: `/category/${categoryInfo.slug}/` }] : []),
  { label: title, href: articleHref },
];

const jsonLd = [
  articleSchema({ title, description, href: articleHref, pubDate, updatedDate, image: ogImage }),
  breadcrumbListSchema(breadcrumbItems),
];
---

<BaseLayout title={title} description={description} ogImage={ogImage} jsonLd={jsonLd}>
  <article>
    <Breadcrumbs items={breadcrumbItems} />

    {categoryInfo && (
      <a
        href={`/category/${categoryInfo.slug}/`}
        class="mb-4 inline-block rounded bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700 hover:underline"
      >
        {categoryInfo.name}
      </a>
    )}
    <h1 class="mb-3 text-3xl font-extrabold leading-snug tracking-tight text-ink">{title}</h1>
    <div class="mb-7 text-sm text-slate-500">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString("ja-JP", dateFormat)} 公開
      </time>
      {updatedDate && (
        <span>
          ({updatedDate.toLocaleDateString("ja-JP", dateFormat)} 更新)
        </span>
      )}
    </div>

    <AdDisclosure />

    <div class="prose prose-slate max-w-none prose-headings:font-extrabold prose-headings:text-ink prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline prose-strong:text-ink">
      <slot />
    </div>
  </article>

  <RelatedArticles currentId={slug} category={category} />
</BaseLayout>
